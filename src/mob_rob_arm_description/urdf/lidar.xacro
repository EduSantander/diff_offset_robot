<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- LiDAR 2D simple: un link + una junta fija (geometria aproximada).
       name: nombre del link y del frame de los datos | parent: base_link, NO la torreta -->
  <xacro:macro name="lidar" params="name parent xyz rpy">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
        <material name="${name}_mat"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

</robot>